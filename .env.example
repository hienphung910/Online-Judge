# =====================================================================
#  PTIT Online Judge - mau cau hinh moi truong
# =====================================================================
#  Chep file nay thanh `.env` roi dien gia tri that:
#
#      Windows PowerShell :  Copy-Item .env.example .env
#      Linux / macOS      :  cp .env.example .env
#
#  File `.env` da nam trong .gitignore nen mat khau khong bi day len git.
#  Bien moi truong that (export / $env:) LUON duoc uu tien hon file .env.
#
#  Truoc do nho tao CSDL va tai khoan oj_app:
#      mysql -u root -p < database/mysql/01_create_database.sql
# =====================================================================

# --- Ket noi MySQL cho che do chay that (--serve va menu console) ---
OJ_DB_URL=jdbc:mysql://localhost:3306/online_judge?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true
OJ_DB_USER=oj_app
OJ_DB_PASSWORD=change_me

# --- Ket noi MySQL cho bo kiem thu tich hop (--apitest) ---
# Ten CSDL BAT BUOC ket thuc bang _test, neu khong chuong trinh se tu choi chay
# kiem thu (de khong bao gio xoa nham du lieu that).
OJ_TEST_DB_URL=jdbc:mysql://localhost:3306/online_judge_test?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true
OJ_TEST_DB_USER=oj_app
OJ_TEST_DB_PASSWORD=change_me

# --- Mat khau tai khoan quan tri, chi dung O LAN CHAY DAU TIEN ---
# Bo trong thi chuong trinh tu sinh mat khau ngau nhien va in ra terminal
# dung mot lan. Cac lan chay sau khong bao gio dat lai mat khau admin.
OJ_ADMIN_PASSWORD=change_me_too

# --- Mat khau chung cua 4 tai khoan mau, chi dung khi bang users con trong ---
OJ_SEED_PASSWORD=change_me_too
